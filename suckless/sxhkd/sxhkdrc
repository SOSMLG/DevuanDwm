# === LAUNCH ===

# !Launch Rofi Application Menu (primary launcher)
super + space
	rofi -show drun -modi drun -line-padding 4 -hide-scrollbar -show-icons -theme ~/.config/suckless/rofi/config.rasi

# Launch Browser (Firefox-esr)
super + b
	firefox-esr

# Launch Private Browser (Firefox private window)
super + shift + b
	firefox-esr -private-window

# Show Keybinding Help Script
super + slash
	~/.config/suckless/scripts/help

# Launch File Manager (Thunar)
super + f
	thunar

# Launch Codium (Text Editor)
super + e
	codium

# Launch GIMP (Image Editor)
super + g
	gimp

# Firefox (already bound on super+b; kept for the old helium key)
super + c
	firefox-esr

# Firefox private window
super + shift + c
	firefox-esr -private-window

# Launch Vesktop (Discord client)
super + d
	vesktop

# Launch OBS (Screen Recording/Streaming)
super + o
	obs

# === WINDOW ===

# DWM Layout Menu
super + shift + l
	~/.config/suckless/scripts/dwm-layout-menu.sh

# Wallpaper picker (dmenu over the bundled darkmatter set, then applies
# the static Darkmatter palette to Xresources/rofi/dunst/kitty)
super + shift + p
	~/.config/suckless/scripts/wallpaper-theme

# Reload the native bar (slstatus) — recovery
super + ctrl + r
	~/.config/suckless/scripts/bar restart

# Network app (super+n is dwm's window-follow toggle)
super + shift + n
	~/.config/suckless/scripts/network

# Tab attach: focused window into a tab group on this monitor
super + w
	~/.config/suckless/dwm/dwmtabs attach

# Tab detach: focused window out of its tab group
super + shift + w
	~/.config/suckless/dwm/dwmtabs detach

# === MEDIA & BRIGHTNESS ===

# Increase Volume (Custom Script)
super + F12
	~/.config/suckless/scripts/changevolume up

# Decrease Volume (Custom Script)
super + F11
	~/.config/suckless/scripts/changevolume down

# Toggle Mute (Custom Script)
super + F10
	~/.config/suckless/scripts/changevolume mute

# Dedicated Key for Volume Up
XF86AudioRaiseVolume
	~/.config/suckless/scripts/changevolume up

# Dedicated Key for Volume Down
XF86AudioLowerVolume
	~/.config/suckless/scripts/changevolume down

# Dedicated Key for Mute
XF86AudioMute
	~/.config/suckless/scripts/changevolume mute

# Increase Screen Brightness
XF86MonBrightnessUp
	xbacklight +10

# Decrease Screen Brightness
XF86MonBrightnessDown
	xbacklight -10

# === SCREENSHOTS ===

# Take a Screenshot (Region Select)
super + shift + s
	~/.config/suckless/scripts/screenshot region

# Take a Fullscreen Screenshot
super + s
	~/.config/suckless/scripts/screenshot full

# === SYSTEM ===

# Reload sxhkd (Hotkey Daemon)
super + Escape
	pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# Power Off/Reboot
super + x
	~/.config/suckless/scripts/power
