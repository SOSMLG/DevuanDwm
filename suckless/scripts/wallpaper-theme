#!/bin/sh

# wallpaper-theme — pick a wallpaper and re-apply the static Darkmatter
# palette (near-black #121113, red accent #e75353) to everything that
# takes colors from this repo. The palette is compiled-in, not derived
# from the image — the fork is Darkmatter-static, so a matching image
# keeps Xresources/rofi/dunst/kitty in lockstep with dwm's config.def.h.
#
# usage:
#   wallpaper-theme              pick from the bundled set via dmenu
#   wallpaper-theme <image>      apply that image
#
# Sections: 1 dwm+st (Xresources) · 2 rofi · 3 dunst · 4 kitty ·
# 5 wallpaper + persisted autostart · 6 reload

set -u

CONFIG_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
WALLPAPER_DIR="$CONFIG_DIR/wallpaper"

BG=#121113; ALTBG=#1c1b1d; FG=#ffffff
PRIMARY=#e75353; SECONDARY=#999999; ALERT=#e75353; DISABLED=#333333
ANSI='#060506 #e75353 #5f8787 #fbcb97 #999999 #e75353 #fbcb97 #c1c1c1
      #333333 #e75353 #5f8787 #fbcb97 #aaaaaa #e75353 #fbcb97 #ffffff'
set -- $ANSI

IMG="${1:-}"
if [ -z "$IMG" ]; then
    # bare call — the picker. Empty selection falls through to appling
    # the palette to the current wallpaper, which is a no-op re-theme.
    IMG=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \
        \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' \) -printf '%f\n' |
        sort | dmenu -p "Wallpaper" -i)
    [ -n "$IMG" ] && IMG="$WALLPAPER_DIR/$IMG"
fi
[ -z "$IMG" ] && [ -f "$HOME/.cache/dwm/current_wallpaper" ] && \
    IMG="$(cat "$HOME/.cache/dwm/current_wallpaper")"
[ -f "$IMG" ] || { echo "no such wallpaper: $IMG" >&2; exit 1; }

# Serialize concurrent runs — the last pick wins whole. Spawned daemons
# must not inherit fd 9 (the 9>&- below) or the lock outlives the script;
# the bounded wait turns a leaked lock into a delay, not a deadlock.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/wallpaper-theme.lock"
flock -w 60 9 || echo "wallpaper-theme: lock timeout, proceeding unlocked" >&2

# 1. dwm + st colors via Xresources, in a marker-bracketed block (the
#    legacy "dwm-thememenu" marker name lets upgrades replace an existing
#    block instead of stacking a second). dwm re-reads xrdb on restart
#    (step 6); st picks the colors up in new terminals.
XRES="$HOME/.Xresources"
touch "$XRES"
sed -i '/^! BEGIN dwm-thememenu$/,/^! END dwm-thememenu$/d' "$XRES"
{
    echo "! BEGIN dwm-thememenu"
    cat <<EOF
! Static Darkmatter palette
dwm.normbgcolor:     $BG
dwm.normfgcolor:     #c1c1c1
dwm.normbordercolor: $ALTBG
dwm.selbgcolor:      $PRIMARY
dwm.selfgcolor:      $FG
dwm.selbordercolor:  $PRIMARY

st.background:  $BG
st.foreground:  $FG
st.cursorColor: $PRIMARY

st.color0:  $1
st.color1:  $2
st.color2:  $3
st.color3:  $4
st.color4:  $5
st.color5:  $6
st.color6:  $7
st.color7:  $8
st.color8:  $9
st.color9:  ${10}
st.color10: ${11}
st.color11: ${12}
st.color12: ${13}
st.color13: ${14}
st.color14: ${15}
st.color15: ${16}
EOF
    echo "! END dwm-thememenu"
} >> "$XRES"
xrdb -load "$XRES"

# 2. Rofi.
cat > "$CONFIG_DIR/rofi/colors.rasi" <<EOF
/* Darkmatter — static palette (bg #121113, accent #e75353). */

* {
    bg:          $BG;
    fg:          $FG;
    accent:      $PRIMARY;
    accent-2:    $SECONDARY;
    border:      $PRIMARY;
    urgent:      $ALERT;
    selected-fg: #121113;
    entry-fg:    $SECONDARY;
    prompt-fg:   $PRIMARY;
    header:      $SECONDARY;

    background-color: @bg;
}
EOF

# 3. Dunst — replace the quoted hex on each `# THEME: dunst_<key>` marker line.
DUNSTRC="$CONFIG_DIR/dunst/dunstrc"
set_dunst() { sed -i "/# THEME: dunst_$1\$/s/\"#[0-9a-fA-F]*\"/\"$2\"/" "$DUNSTRC"; }
set_dunst frame_global       "$PRIMARY"
set_dunst bg_low             "$BG"
set_dunst fg_low             "$DISABLED"
set_dunst frame_low          "$PRIMARY"
set_dunst highlight_low      "$SECONDARY"
set_dunst bg_normal          "$BG"
set_dunst fg_normal          "#c1c1c1"
set_dunst frame_normal       "$PRIMARY"
set_dunst highlight_normal   "$PRIMARY"
set_dunst bg_critical        "$BG"
set_dunst fg_critical        "$FG"
set_dunst frame_critical     "$ALERT"
set_dunst highlight_critical "$ALERT"

# 4. Kitty — session-local config dir (KITTY_CONFIG_DIRECTORY); SIGUSR1
#    reloads running instances. ~/.config/kitty is left alone.
if mkdir -p "$CONFIG_DIR/kitty"; then
    cat > "$CONFIG_DIR/kitty/current-theme.conf" <<EOF
# vim:ft=kitty
## name: Darkmatter
## generated by wallpaper-theme

# Basic colors
foreground           $FG
background           $BG
selection_foreground $FG
selection_background $ALTBG

# Cursor colors
cursor            $PRIMARY
cursor_text_color $BG

# URL underline color when hovering with mouse
url_color $SECONDARY

# Window border colors and terminal bell colors
active_border_color   $PRIMARY
inactive_border_color $DISABLED
bell_border_color     #fbcb97
visual_bell_color     none

# Tab bar colors
active_tab_foreground   $BG
active_tab_background   $PRIMARY
inactive_tab_foreground #c1c1c1
inactive_tab_background $ALTBG
tab_bar_background      $BG
tab_bar_margin_color    none

# Mark colors (marked text in the terminal)
mark1_foreground $BG
mark1_background $PRIMARY
mark2_foreground $BG
mark2_background #fbcb97
mark3_foreground $BG
mark3_background $SECONDARY

# The basic 16 colors
color0  $1
color1  $2
color2  $3
color3  $4
color4  $5
color5  $6
color6  $7
color7  $8
color8  $9
color9  ${10}
color10 ${11}
color11 ${12}
color12 ${13}
color13 ${14}
color14 ${15}
color15 ${16}
EOF
    pkill -USR1 -x kitty 2>/dev/null || true
fi

# 5. Wallpaper now + persisted into autostart so it survives logins. The
#    dunst symlink follows the active session's config.
#    Written as a literal $HOME path — an expanded one bakes this user's
#    home into autostart.sh, which breaks for everyone else if the file
#    is ever synced back into the setup repo.
feh --bg-fill "$IMG"
sed -i "s|feh --bg-[a-z]* .*|feh --bg-fill \"\$HOME${CONFIG_DIR#"$HOME"}/wallpaper/$(basename "$IMG")\" \&|" "$CONFIG_DIR/scripts/autostart.sh"
mkdir -p "$HOME/.cache/dwm" "$HOME/.config/dunst"
echo "$IMG" > "$HOME/.cache/dwm/current_wallpaper"
ln -sfn "$CONFIG_DIR/dunst/dunstrc" "$HOME/.config/dunst/dunstrc"

# 6. Reload — dunst is respawned with the new colors; dwm re-reads xrdb
#    and restyles in place via the extbar patch's _DWM_RELOADCOLORS atom
#    (no re-exec: selected tags and pertag state survive).
pkill -x dunst 2>/dev/null || true
dunst -config "$CONFIG_DIR/dunst/dunstrc" >/dev/null 2>&1 9>&- &
xprop -root -f _DWM_RELOADCOLORS 32c -set _DWM_RELOADCOLORS 1 2>/dev/null || true

sleep 0.5
notify-send -a "dwm-setup" -t 2500 "Wallpaper" "$(basename "$IMG") — Darkmatter"